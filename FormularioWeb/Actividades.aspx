<%@ Page Title="Actividades académicas" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Actividades.aspx.cs" Inherits="FormularioWeb.Actividades" ResponseEncoding="utf-8" Culture="es-CO" UICulture="es-CO" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
<link rel="preconnect" href="https://fonts.googleapis.com" /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet" />
<style>
body{background:#f3f6fb;font-family:'DM Sans',sans-serif;color:#172b4d}.container.body-content{max-width:1600px;width:96%;padding:0;margin:0 auto}.dashboard{padding:24px 0 40px}.hero{background:linear-gradient(115deg,#16376f,#2862aa);color:#fff;border-radius:18px;padding:25px 30px;display:flex;justify-content:space-between;align-items:center;box-shadow:0 10px 28px #16376f25}.hero h1{font:800 28px Manrope;margin:0 0 5px}.hero p{margin:0;color:#dbeafe}.hero-mark{font-size:48px;opacity:.8}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:18px 0}.stat,.card{background:#fff;border:1px solid #e3eaf4;border-radius:14px;box-shadow:0 3px 12px #1b3d6410}.stat{padding:15px 18px;display:flex;align-items:center;gap:13px}.stat i{font-style:normal;font-size:25px;background:#edf4ff;padding:10px;border-radius:12px}.stat b{display:block;font:800 24px Manrope;color:#173b73}.stat span{color:#60728a;font-size:13px}.columns{display:grid;grid-template-columns:minmax(360px,.92fr) minmax(520px,1.35fr);gap:16px}.card{padding:18px;margin-bottom:16px}.card h2{font:700 17px Manrope;color:#173b73;margin:0 0 16px}.formgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.field label{display:block;font-size:12px;font-weight:700;margin-bottom:5px}.field input,.field select,.field textarea,.search{width:100%;border:1px solid #d8e0eb;border-radius:8px;padding:9px 10px;font:14px 'DM Sans';box-sizing:border-box}.field textarea{height:68px}.wide{grid-column:1/-1}.actions{margin-top:14px;display:flex;gap:8px}.btnx{border:0;border-radius:8px;padding:10px 16px;font-weight:700;cursor:pointer;background:#1768c4;color:#fff}.secondary{background:#edf1f7;color:#26364b}.danger{background:#dc4050;color:#fff}.msg{display:block;margin:14px 0;padding:13px 16px;border-radius:10px;background:#edf5ff;color:#164b88;border-left:4px solid #3982d5;font-weight:600;box-shadow:0 5px 16px #193b6210;animation:appear .22s ease-out}.msg.success{background:#eaf8f0;color:#12643d;border-color:#22a365}.msg.success:before{content:"✓";font-weight:800;margin-right:10px}.msg.error{background:#fff0ef;color:#9a2824;border-color:#d84b45}.msg.error:before{content:"!";font-weight:800;margin-right:10px}.msg.info{background:#edf5ff;color:#164b88;border-color:#3982d5}@keyframes appear{from{opacity:0;transform:translateY(-5px)}to{opacity:1;transform:translateY(0)}}.card{transition:box-shadow .2s,transform .2s}.card:hover{box-shadow:0 10px 28px #1b3d6418}.btnx{transition:filter .15s,transform .15s}.btnx:hover{filter:brightness(1.06);transform:translateY(-1px)}.tablewrap{overflow:auto}.data{width:100%;border-collapse:separate;border-spacing:0;font-size:12px;min-width:600px}.data th{background:#f1f4f8;text-align:left;color:#25364d;padding:12px 10px;font-weight:700;white-space:nowrap}.data th:first-child{border-radius:8px 0 0 0}.data th:last-child{border-radius:0 8px 0 0}.data td{padding:10px;border-bottom:1px solid #e9edf2;vertical-align:middle}.activity-list tr:hover td{background:#f8fbff}.estado{display:inline-block;padding:5px 9px;border-radius:7px;background:#fff2cf;color:#946000;font-weight:700;white-space:nowrap}.estado.activa{background:#dff3e8;color:#187143}.estado.finalizada{background:#e8ebf0;color:#4d5867}.estado.cancelada{background:#fde4e4;color:#a02c32}.accion{display:inline-flex;width:30px;height:30px;align-items:center;justify-content:center;margin:0 2px;border-radius:6px;color:#fff!important;text-decoration:none!important;font-size:17px;font-weight:700}.accion:hover{filter:brightness(.92);transform:translateY(-1px)}.accion.ver,.accion.editar{background:#1976d2}.accion.borrar{background:#df4650;font-size:22px}.pager td{padding:14px 4px;border:0}.pager a,.pager span{display:inline-block;min-width:30px;padding:7px 9px;text-align:center;border:1px solid #e2e8f0;border-radius:6px;margin-left:4px;text-decoration:none;color:#33445c}.pager span{background:#1768c4;color:white;border-color:#1768c4}.tools .search{max-width:250px}.data tr:last-child td{border-bottom:0}.badge{background:#e5f5ed;color:#167044;border-radius:99px;padding:4px 9px;font-weight:700}.tools{display:flex;gap:10px;align-items:center;justify-content:space-between;margin-bottom:12px}.tools h2{margin:0}.small{padding:7px 9px;font-size:12px}.below{display:grid;grid-template-columns:.9fr 1.35fr;gap:16px}.detail-card h2,.roster-card h2,.reviews-card h2{display:flex;align-items:center;gap:8px;padding:10px 12px;margin:-18px -18px 16px;background:linear-gradient(90deg,#edf5ff,#f8fbff);border-radius:13px 13px 0 0}.detail-table{width:100%;border-collapse:collapse;font-size:13px}.detail-table th{width:112px;text-align:left;vertical-align:top;padding:5px 8px 5px 0;color:#263b58}.detail-table td{padding:5px 0;color:#28364b}.roster-heading{display:flex;align-items:center;justify-content:space-between;gap:8px}.roster-heading h2{flex:1}.count-chip{display:inline-block;min-width:24px;padding:3px 8px;text-align:center;border-radius:20px;background:#dcecff;color:#1768c4;font:700 12px "DM Sans"}.helper{font-size:11px;color:#718096}.roster-list{min-width:560px}.roster-actions{display:flex;align-items:center;gap:7px}.roster-actions select{max-width:180px;padding:7px;border:1px solid #d8e0eb;border-radius:7px;font-size:12px}.btnx.enroll{margin:0;padding:8px 10px;background:#22a66a;white-space:nowrap}.reviews-card{grid-column:1/-1}.review-form{display:grid;grid-template-columns:180px 1fr auto;gap:12px;align-items:end}.review-form textarea{height:42px}.detail-card .actions{flex-wrap:wrap}.link{color:#1768c4;font-weight:700;margin-right:8px}.admin-heading{display:flex;align-items:center;justify-content:space-between;gap:12px}.admin-heading h2{margin:0 0 5px}.admin-heading p{margin:0;color:#718096;font-size:13px}.student-search{display:flex;gap:8px;max-width:600px;margin:16px 0}.student-list{min-width:800px}.student-editor{margin-top:18px;padding:16px;background:#f8fbff;border:1px solid #dce8f6;border-radius:12px}.student-editor h3{margin-top:0;color:#173b73}.student-admin{grid-column:1/-1}.footer-note{color:#8391a5;font-size:12px;text-align:right}@media(max-width:900px){.columns,.below{grid-template-columns:1fr}.reviews-card{grid-column:auto}.student-admin{grid-column:auto}.student-search{flex-wrap:wrap}.review-form{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}.container.body-content{width:94%}}@media(max-width:520px){.stats{grid-template-columns:1fr 1fr}.formgrid{grid-template-columns:1fr}.wide{grid-column:auto}.hero h1{font-size:22px}}
</style>
<div class="dashboard">
<section class="hero"><div><h1>Actividades académicas</h1><p>Organiza encuentros, talleres y experiencias de aprendizaje.</p></div><div class="hero-mark">✦</div></section>
<div class="stats"><div class="stat"><i>ACT</i><div><b><asp:Label ID="lblTotal" runat="server" Text="0" /></b><span>Actividades</span></div></div><div class="stat"><i>INS</i><div><b><asp:Label ID="lblInscritos" runat="server" Text="0" /></b><span>Inscripciones</span></div></div><div class="stat"><i>PRO</i><div><b><asp:Label ID="lblProximas" runat="server" Text="0" /></b><span>Próximas</span></div></div><div class="stat"><i>FIN</i><div><b><asp:Label ID="lblFinalizadas" runat="server" Text="0" /></b><span>Finalizadas</span></div></div></div>
<asp:Label ID="lblMensaje" runat="server" CssClass="msg" Visible="false" />
<div class="columns"><section class="card"><h2>＋ &nbsp;Crear o editar actividad</h2><asp:HiddenField ID="hfId" runat="server" Value="0"/><div class="formgrid">
<div class="field"><label>Título *</label><asp:TextBox ID="txtTitulo" runat="server" MaxLength="120" /></div><div class="field"><label>Tipo *</label><asp:DropDownList ID="ddlTipo" runat="server"><asp:ListItem>Taller</asp:ListItem><asp:ListItem>Conferencia</asp:ListItem><asp:ListItem>Seminario</asp:ListItem><asp:ListItem>Curso</asp:ListItem><asp:ListItem>Encuentro</asp:ListItem><asp:ListItem>Otro</asp:ListItem></asp:DropDownList></div>
<div class="field wide"><label>Descripción *</label><asp:TextBox ID="txtDescripcion" runat="server" TextMode="MultiLine" MaxLength="1000" /></div><div class="field"><label>Fecha inicio *</label><asp:TextBox ID="txtFechaInicio" runat="server" TextMode="Date" onchange="actualizarHoraMinima()" /></div><div class="field"><label>Fecha fin *</label><asp:TextBox ID="txtFechaFin" runat="server" TextMode="Date" /></div><div class="field"><label>Hora inicio *</label><asp:TextBox ID="txtHoraInicio" runat="server" TextMode="Time" /></div><div class="field"><label>Hora fin *</label><asp:TextBox ID="txtHoraFin" runat="server" TextMode="Time" /></div><div class="field"><label>Modalidad</label><asp:DropDownList ID="ddlModalidad" runat="server"><asp:ListItem>Presencial</asp:ListItem><asp:ListItem>Virtual</asp:ListItem><asp:ListItem>Híbrida</asp:ListItem></asp:DropDownList></div><div class="field"><label>Cupo disponible *</label><asp:TextBox ID="txtCupo" runat="server" TextMode="Number" /></div><div class="field"><label>Lugar *</label><asp:TextBox ID="txtLugar" runat="server" MaxLength="150" /></div><div class="field"><label>Estado</label><asp:DropDownList ID="ddlEstado" runat="server"><asp:ListItem>Próxima</asp:ListItem><asp:ListItem>Activa</asp:ListItem><asp:ListItem>Finalizada</asp:ListItem><asp:ListItem>Cancelada</asp:ListItem></asp:DropDownList></div></div><div class="actions"><asp:Button ID="btnGuardar" runat="server" Text="Guardar actividad" CssClass="btnx" OnClick="btnGuardar_Click"/><asp:Button ID="btnLimpiar" runat="server" Text="Limpiar" CssClass="btnx secondary" CausesValidation="false" OnClick="btnLimpiar_Click"/></div></section>
<section class="card"><div class="tools"><h2>Listado de actividades</h2><asp:TextBox ID="txtBuscar" runat="server" CssClass="search" placeholder="Buscar por título, tipo o estado…" /></div><div class="actions" style="margin:0 0 12px"><asp:Button ID="btnBuscar" runat="server" Text="Buscar" CssClass="btnx small" CausesValidation="false" OnClick="btnBuscar_Click"/><asp:Button ID="btnTodas" runat="server" Text="Ver todas" CssClass="btnx secondary small" CausesValidation="false" OnClick="btnTodas_Click"/></div><div class="tablewrap"><asp:GridView ID="gvActividades" runat="server" CssClass="data activity-list" AutoGenerateColumns="false" GridLines="None" EmptyDataText="No hay actividades para mostrar." AllowPaging="true" PageSize="5" OnPageIndexChanging="gvActividades_PageIndexChanging" OnRowCommand="gvActividades_RowCommand" OnRowDataBound="gvActividades_RowDataBound"><Columns><asp:TemplateField HeaderText="#"><ItemTemplate><%# (gvActividades.PageIndex * gvActividades.PageSize) + Container.DataItemIndex + 1 %></ItemTemplate></asp:TemplateField><asp:BoundField DataField="Titulo" HeaderText="Título"/><asp:BoundField DataField="Tipo" HeaderText="Tipo"/><asp:BoundField DataField="FechaInicio" HeaderText="Fecha" DataFormatString="{0:dd/MM/yyyy}"/><asp:TemplateField HeaderText="Cupos"><ItemTemplate><%# Eval("Cupo") %></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Estado"><ItemTemplate><asp:Label ID="lblEstadoFila" runat="server" Text='<%# Eval("Estado") %>' CssClass="estado" /></ItemTemplate></asp:TemplateField><asp:TemplateField HeaderText="Acciones"><ItemTemplate><asp:LinkButton runat="server" CommandName="ver" CommandArgument='<%# Eval("Id") %>' CssClass="accion ver" ToolTip="Ver detalle" Text="◉" CausesValidation="false"/><asp:LinkButton runat="server" CommandName="editar" CommandArgument='<%# Eval("Id") %>' CssClass="accion editar" ToolTip="Editar actividad" Text="✎" CausesValidation="false"/><asp:LinkButton runat="server" CommandName="eliminar" CommandArgument='<%# Eval("Id") %>' CssClass="accion borrar" ToolTip="Eliminar actividad" Text="×" CausesValidation="false" OnClientClick="return confirm('¿Eliminar esta actividad?')"/></ItemTemplate></asp:TemplateField></Columns><PagerSettings Mode="NumericFirstLast" FirstPageText="«" LastPageText="»" PageButtonCount="5"/><PagerStyle CssClass="pager" HorizontalAlign="Right"/></asp:GridView></div></section></div>
<div class="below"><section class="card detail-card"><h2>Detalles de la actividad</h2><asp:Label ID="lblDetalle" runat="server" Text="Selecciona una actividad del listado para consultar sus detalles."/><div class="actions"><asp:Button ID="btnReportes" runat="server" Text="Exportar reporte CSV" CssClass="btnx secondary" CausesValidation="false" OnClick="btnReportes_Click"/></div></section><section class="card roster-card"><div class="roster-heading"><h2>Estudiantes inscritos <span class="count-chip"><asp:Label ID="lblTotalInscritos" runat="server" Text="0"/></span></h2><div class="roster-actions"><asp:DropDownList ID="ddlEstudiante" runat="server"/><asp:Button ID="btnInscribir" runat="server" Text="＋ Inscribir" CssClass="btnx enroll" CausesValidation="false" OnClick="btnInscribir_Click"/></div></div><div class="tablewrap"><asp:GridView ID="gvInscritos" runat="server" CssClass="data roster-list" AutoGenerateColumns="false" GridLines="None" EmptyDataText="Aún no hay estudiantes inscritos en esta actividad." OnRowCommand="gvInscritos_RowCommand"><Columns><asp:TemplateField HeaderText="#"><ItemTemplate><%# Container.DataItemIndex + 1 %></ItemTemplate></asp:TemplateField><asp:BoundField DataField="Nombre" HeaderText="Nombre"/><asp:BoundField DataField="Programa" HeaderText="Programa"/><asp:BoundField DataField="FechaInscripcion" HeaderText="Fecha de inscripción" DataFormatString="{0:dd/MM/yyyy}"/><asp:TemplateField HeaderText="Acciones"><ItemTemplate><asp:LinkButton runat="server" Text="×" CommandName="retirar" CommandArgument='<%# Eval("InscripcionId") %>' CssClass="accion borrar" ToolTip="Retirar inscripción" CausesValidation="false" OnClientClick="return confirm('¿Retirar esta inscripción de la actividad?')"/></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div></section></div><section class="card student-admin"><div class="admin-heading"><div><h2>Estudiantes registrados</h2><p>Consulta y administra las fichas académicas desde el área administrativa.</p></div><asp:Label ID="lblTotalEstudiantes" runat="server" CssClass="count-chip" Text="0 estudiantes"/></div><div class="student-search"><asp:TextBox ID="txtBuscarEstudiante" runat="server" CssClass="search" placeholder="Buscar por cédula, nombre o correo"/><asp:Button ID="btnBuscarEstudiante" runat="server" Text="Buscar" CssClass="btnx small" CausesValidation="false" OnClick="btnBuscarEstudiante_Click"/><asp:Button ID="btnTodosEstudiantes" runat="server" Text="Ver todos" CssClass="btnx secondary small" CausesValidation="false" OnClick="btnTodosEstudiantes_Click"/></div><div class="tablewrap"><asp:GridView ID="gvEstudiantesAdmin" runat="server" CssClass="data student-list" AutoGenerateColumns="false" GridLines="None" EmptyDataText="No hay estudiantes registrados." OnRowCommand="gvEstudiantesAdmin_RowCommand" OnRowDataBound="gvEstudiantesAdmin_RowDataBound"><Columns><asp:BoundField DataField="Cedula" HeaderText="Cédula"/><asp:BoundField DataField="Nombres" HeaderText="Nombres"/><asp:BoundField DataField="Apellidos" HeaderText="Apellidos"/><asp:BoundField DataField="Correo" HeaderText="Correo"/><asp:BoundField DataField="Programa" HeaderText="Programa"/><asp:BoundField DataField="Semestre" HeaderText="Semestre"/><asp:BoundField DataField="InscripcionesActivas" HeaderText="Inscripciones"/><asp:TemplateField HeaderText="Acciones"><ItemTemplate><asp:LinkButton runat="server" Text="Editar" CommandName="editar" CommandArgument='<%# Eval("Id") %>' CssClass="link" CausesValidation="false"/><asp:LinkButton runat="server" Text="Eliminar" CommandName="eliminar" CommandArgument='<%# Eval("Id") %>' CssClass="link delete-link" CausesValidation="false"/></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div><asp:Panel ID="pnlEditarEstudiante" runat="server" Visible="false" CssClass="student-editor"><h3>Actualizar datos del estudiante</h3><asp:HiddenField ID="hfEstudianteId" runat="server"/><div class="formgrid"><div class="field"><label>Cédula</label><asp:TextBox ID="txtAdminCedula" runat="server" MaxLength="20"/></div><div class="field"><label>Nombres</label><asp:TextBox ID="txtAdminNombres" runat="server" MaxLength="100"/></div><div class="field"><label>Apellidos</label><asp:TextBox ID="txtAdminApellidos" runat="server" MaxLength="100"/></div><div class="field"><label>Correo</label><asp:TextBox ID="txtAdminCorreo" runat="server" TextMode="Email" MaxLength="150"/></div><div class="field"><label>Teléfono</label><asp:TextBox ID="txtAdminTelefono" runat="server" MaxLength="20"/></div><div class="field"><label>Programa</label><asp:TextBox ID="txtAdminPrograma" runat="server" MaxLength="100"/></div><div class="field"><label>Semestre</label><asp:DropDownList ID="ddlAdminSemestre" runat="server"><asp:ListItem>1</asp:ListItem><asp:ListItem>2</asp:ListItem><asp:ListItem>3</asp:ListItem><asp:ListItem>4</asp:ListItem><asp:ListItem>5</asp:ListItem><asp:ListItem>6</asp:ListItem><asp:ListItem>7</asp:ListItem><asp:ListItem>8</asp:ListItem><asp:ListItem>9</asp:ListItem><asp:ListItem>10</asp:ListItem></asp:DropDownList></div></div><asp:Button ID="btnGuardarEstudiante" runat="server" Text="Guardar cambios" CssClass="btnx" OnClick="btnGuardarEstudiante_Click"/><asp:Button ID="btnCancelarEdicionEstudiante" runat="server" Text="Cancelar" CssClass="btnx secondary" CausesValidation="false" OnClick="btnCancelarEdicionEstudiante_Click"/></asp:Panel><asp:Label ID="lblMensajeEstudiantes" runat="server" Visible="false" CssClass="msg"/></section><div class="footer-note">UniCampus · Gestión académica</div></div>
<script type="text/javascript">
function actualizarHoraMinima(){var inicio=document.getElementById('<%= txtFechaInicio.ClientID %>');var hora=document.getElementById('<%= txtHoraInicio.ClientID %>');var id=document.getElementById('<%= hfId.ClientID %>');if(!inicio||!hora)return;if(id&&id.value!=="0"){hora.removeAttribute("min");return;}var ahora=new Date();var fechaHoy=new Date(ahora.getTime()-ahora.getTimezoneOffset()*60000).toISOString().slice(0,10);inicio.min=fechaHoy;if(inicio.value===fechaHoy){hora.min=String(ahora.getHours()).padStart(2,"0")+":"+String(ahora.getMinutes()).padStart(2,"0");}else{hora.removeAttribute("min");}}
document.addEventListener("DOMContentLoaded",actualizarHoraMinima);
</script></asp:Content>











