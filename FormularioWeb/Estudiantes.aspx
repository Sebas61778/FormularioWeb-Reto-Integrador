<%@ Page Title="Registro de estudiante" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Estudiantes.aspx.cs" Inherits="FormularioWeb.AdministrarEstudiantes" ResponseEncoding="utf-8" Culture="es-CO" UICulture="es-CO" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
<style>.students{max-width:1200px;margin:28px auto;padding:0 14px;color:#19365f}.studenthead{background:linear-gradient(120deg,#17366d,#2772bf);color:#fff;padding:24px 28px;border-radius:16px}.studentcard{background:#fff;padding:20px;border:1px solid #e1e9f4;border-radius:14px;margin:16px 0;box-shadow:0 6px 20px #17366d12}.sgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.students label{display:block;font-size:13px;font-weight:700}.students input,.students select{width:100%;padding:9px;border:1px solid #d0dceb;border-radius:8px;box-sizing:border-box}.sb{border:0;border-radius:8px;padding:9px 14px;background:#1768c4;color:white;font-weight:700;margin:12px 6px 0 0;cursor:pointer}.gray{background:#edf1f7;color:#223}.warning{display:block;padding:12px;background:#edf5ff;border-radius:9px;margin:12px 0}.success{background:#eaf8f0;color:#12643d}.err{background:#fff0ef;color:#9a2824}.sgtable{width:100%;border-collapse:collapse}.sgtable th,.sgtable td{padding:9px;border-bottom:1px solid #e8edf4;text-align:left}.sgtable th{background:#f2f6fb}.scroll{overflow:auto}@media(max-width:800px){.sgrid{grid-template-columns:1fr 1fr}}@media(max-width:500px){.sgrid{grid-template-columns:1fr}}</style>
<main class="students"><header class="studenthead"><h1>Registro de estudiante</h1><div>Crea tu cuenta con tus datos personales y académicos para inscribirte en las actividades.</div></header><asp:Label ID="lblMensaje" runat="server" Visible="false"/><section class="studentcard"><h2><asp:Label ID="lblFormulario" runat="server" Text="Crear cuenta de estudiante"/></h2><asp:HiddenField ID="hfId" runat="server" Value="0"/><div class="sgrid"><div><label>Cédula *</label><asp:TextBox ID="txtCedula" runat="server" MaxLength="20"/></div><div><label>Nombres *</label><asp:TextBox ID="txtNombres" runat="server" MaxLength="100"/></div><div><label>Apellidos *</label><asp:TextBox ID="txtApellidos" runat="server" MaxLength="100"/></div><div><label>Correo electrónico *</label><asp:TextBox ID="txtCorreo" runat="server" TextMode="Email" MaxLength="150"/></div><div><label>Teléfono</label><asp:TextBox ID="txtTelefono" runat="server" MaxLength="20"/></div><div><label>Programa académico *</label><asp:TextBox ID="txtPrograma" runat="server" MaxLength="100"/></div><div><label>Semestre *</label><asp:DropDownList ID="ddlSemestre" runat="server"><asp:ListItem Value="">Selecciona</asp:ListItem><asp:ListItem>1</asp:ListItem><asp:ListItem>2</asp:ListItem><asp:ListItem>3</asp:ListItem><asp:ListItem>4</asp:ListItem><asp:ListItem>5</asp:ListItem><asp:ListItem>6</asp:ListItem><asp:ListItem>7</asp:ListItem><asp:ListItem>8</asp:ListItem><asp:ListItem>9</asp:ListItem><asp:ListItem>10</asp:ListItem></asp:DropDownList></div><div><label>Contraseña (mínimo 8 caracteres)</label><asp:TextBox ID="txtClaveCuenta" runat="server" TextMode="Password"/></div></div><asp:CheckBox ID="chkDatos" runat="server" Text="Acepto el tratamiento de mis datos personales."/><br/><asp:Button ID="btnGuardar" runat="server" Text="Crear cuenta" CssClass="sb" OnClick="btnGuardar_Click"/><asp:Button ID="btnNuevo" runat="server" Text="Limpiar formulario" CssClass="sb gray" CausesValidation="false" OnClick="btnNuevo_Click"/></section></main>
</asp:Content>



