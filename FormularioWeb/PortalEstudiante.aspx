<%@ Page Title="Portal del estudiante" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="PortalEstudiante.aspx.cs" Inherits="FormularioWeb.PortalEstudiante" ResponseEncoding="utf-8" Culture="es-CO" UICulture="es-CO" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server">
<style>.portal{max-width:1100px;margin:25px auto;padding:0 12px;color:#18345f}.portalhead{background:linear-gradient(120deg,#17366d,#2772bf);padding:26px;border-radius:16px;color:#fff}.portal-userhead{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:16px}.portal-userhead h2{margin:0}.access-layout{display:flex;justify-content:center;align-items:center;min-height:390px}.access-card{width:min(100%,480px);margin:24px auto;padding:30px!important;text-align:left}.login-mark{width:52px;height:52px;border-radius:15px;background:linear-gradient(135deg,#e7f1ff,#d7e8ff);display:grid;place-items:center;color:#1b66b7;font:800 24px Manrope;margin-bottom:16px}.access-card h2{font:800 24px Manrope;color:#183b70;margin:0 0 7px}.login-copy{color:#718096;font-size:14px;line-height:1.5;margin:0 0 22px}.login-field{margin:0 0 15px}.access-card input{height:46px}.access-card input:focus{outline:none;border-color:#4a91dc;box-shadow:0 0 0 3px #2a79c522}.portal .btnp.login-button{width:100%;margin:8px 0 0;padding:12px;font-size:15px;box-shadow:0 5px 12px #1768c433}.register-note{text-align:center;margin:19px 0 0;color:#68788f;font-size:13px}.register-note a{color:#1768c4;font-weight:700;text-decoration:none}.register-note a:hover{text-decoration:underline}.portal .btnp.logout-btn{margin:0;padding:7px 12px;font-size:13px;border:1px solid #d7e5f7;background:#f1f6fd;color:#1b4c84;box-shadow:none}.portal .btnp.logout-btn:hover{background:#e2efff}.portalhead h1{margin:0 0 5px}.portalcard{background:#fff;border:1px solid #e1e9f4;border-radius:14px;padding:20px;margin:16px 0;box-shadow:0 6px 20px #17366d12}.portalgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.portal input,.portal select{width:100%;padding:10px;border:1px solid #cfdae9;border-radius:8px}.portal label{display:block;font-weight:700;font-size:13px;margin-bottom:6px}.portal .btnp{background:#1768c4;color:#fff;border:0;border-radius:8px;padding:10px 15px;font-weight:bold;margin-top:12px}.portalmsg{display:block;padding:12px;background:#eaf8f0;color:#12643d;border-radius:8px;margin:12px 0}.portalerror{background:#fff0ef;color:#9a2824}.portal table{width:100%;border-collapse:collapse}.portal th,.portal td{padding:10px;border-bottom:1px solid #e8edf4;text-align:left}.portal th{background:#f2f6fb}.portal .grid{overflow:auto}.review-state{display:inline-block;padding:5px 8px;border-radius:7px;background:#edf1f7;color:#516176;font-size:12px}.portalcard h3{color:#1c477c}@media(max-width:700px){.portalgrid{grid-template-columns:1fr}.portal-userhead{align-items:flex-start}.access-layout{display:flex;justify-content:center;align-items:center;min-height:390px}.access-card{width:min(100%,480px);margin:24px auto;padding:30px!important;text-align:left}.login-mark{width:52px;height:52px;border-radius:15px;background:linear-gradient(135deg,#e7f1ff,#d7e8ff);display:grid;place-items:center;color:#1b66b7;font:800 24px Manrope;margin-bottom:16px}.access-card h2{font:800 24px Manrope;color:#183b70;margin:0 0 7px}.login-copy{color:#718096;font-size:14px;line-height:1.5;margin:0 0 22px}.login-field{margin:0 0 15px}.access-card input{height:46px}.access-card input:focus{outline:none;border-color:#4a91dc;box-shadow:0 0 0 3px #2a79c522}.portal .btnp.login-button{width:100%;margin:8px 0 0;padding:12px;font-size:15px;box-shadow:0 5px 12px #1768c433}.register-note{text-align:center;margin:19px 0 0;color:#68788f;font-size:13px}.register-note a{color:#1768c4;font-weight:700;text-decoration:none}.register-note a:hover{text-decoration:underline}.portal .btnp.logout-btn{font-size:12px;padding:6px 9px}}</style>
<div class="portal"><div class="portalhead"><h1>Portal del estudiante</h1><div>Consulta actividades disponibles y gestiona tus inscripciones.</div></div><asp:Label ID="lblMensaje" runat="server" Visible="false"/><asp:Panel ID="pnlAcceso" runat="server"><div class="portalgrid access-layout"><section class="portalcard access-card"><div class="login-mark">U</div><h2>Bienvenido de nuevo</h2><p class="login-copy">Ingresa con tu cédula y contraseña para consultar e inscribirte en actividades académicas.</p><div class="login-field"><label for="txtLoginCedula">Número de cédula</label><asp:TextBox ID="txtLoginCedula" runat="server" MaxLength="20" placeholder="Escribe tu cédula" autocomplete="username"/></div><div class="login-field"><label for="txtLoginClave">Contraseña</label><asp:TextBox ID="txtLoginClave" runat="server" TextMode="Password" placeholder="Escribe tu contraseña" autocomplete="current-password"/></div><asp:Button ID="btnLogin" runat="server" Text="Iniciar sesión" CssClass="btnp login-button" OnClick="btnLogin_Click"/><p class="register-note">¿Aún no tienes cuenta? <a href="Estudiantes.aspx">Regístrate aquí</a>.</p></section></div></asp:Panel>
<asp:Panel ID="pnlEstudiante" runat="server" Visible="false"><section class="portalcard"><div class="portal-userhead"><h2>Hola, <asp:Label ID="lblNombre" runat="server"/></h2><asp:Button ID="btnSalir" runat="server" Text="Cerrar sesión" CssClass="btnp logout-btn" CausesValidation="false" OnClick="btnSalir_Click"/></div><h3>Actividades disponibles</h3><div class="grid"><asp:GridView ID="gvDisponibles" runat="server" AutoGenerateColumns="false" EmptyDataText="No hay actividades disponibles por ahora." OnRowCommand="gvDisponibles_RowCommand"><Columns><asp:BoundField DataField="Titulo" HeaderText="Actividad"/><asp:BoundField DataField="Tipo" HeaderText="Tipo"/><asp:BoundField DataField="FechaInicio" HeaderText="Fecha" DataFormatString="{0:dd/MM/yyyy}"/><asp:BoundField DataField="HoraInicio" HeaderText="Hora"/><asp:BoundField DataField="Lugar" HeaderText="Lugar"/><asp:BoundField DataField="Cupo" HeaderText="Cupo"/><asp:BoundField DataField="Inscritos" HeaderText="Inscritos"/><asp:TemplateField HeaderText=""><ItemTemplate><asp:LinkButton ID="btnInscribirme" runat="server" Text="Inscribirme" CommandName="inscribir" CommandArgument='<%# Eval("ActividadId") %>'/></ItemTemplate></asp:TemplateField></Columns></asp:GridView></div><h3>Mis inscripciones</h3><div class="grid"><asp:GridView ID="gvMisInscripciones" runat="server" AutoGenerateColumns="false" EmptyDataText="Aún no tienes inscripciones." OnRowCommand="gvMisInscripciones_RowCommand" OnRowDataBound="gvMisInscripciones_RowDataBound"><Columns><asp:BoundField DataField="Titulo" HeaderText="Actividad"/><asp:BoundField DataField="Tipo" HeaderText="Tipo"/><asp:BoundField DataField="FechaInicio" HeaderText="Fecha" DataFormatString="{0:dd/MM/yyyy}"/><asp:BoundField DataField="HoraInicio" HeaderText="Hora"/><asp:BoundField DataField="Lugar" HeaderText="Lugar"/><asp:BoundField DataField="FechaInscripcion" HeaderText="Inscrito el" DataFormatString="{0:dd/MM/yyyy HH:mm}"/><asp:TemplateField HeaderText="Reseña"><ItemTemplate><asp:LinkButton ID="btnCalificar" runat="server" Text="Calificar" CommandName="calificar" CommandArgument='<%# Eval("ActividadId") %>'/><asp:Label ID="lblEstadoResena" runat="server"/></ItemTemplate></asp:TemplateField></Columns></asp:GridView><asp:Panel ID="pnlCalificar" runat="server" Visible="false" CssClass="portalcard"><h3>Calificar actividad</h3><div><label>Calificación (1 a 5)</label><asp:DropDownList ID="ddlCalificacion" runat="server"><asp:ListItem Value="5">★★★★★ - Excelente</asp:ListItem><asp:ListItem Value="4">★★★★ - Muy buena</asp:ListItem><asp:ListItem Value="3">★★★ - Buena</asp:ListItem><asp:ListItem Value="2">★★ - Regular</asp:ListItem><asp:ListItem Value="1">★ - Debe mejorar</asp:ListItem></asp:DropDownList></div><div style="margin-top:10px"><label>Comentario (opcional)</label><asp:TextBox ID="txtComentarioResena" runat="server" TextMode="MultiLine" MaxLength="1000"/></div><asp:Button ID="btnEnviarResena" runat="server" Text="Enviar calificación" CssClass="btnp" OnClick="btnEnviarResena_Click"/><asp:Button ID="btnCancelarResena" runat="server" Text="Cancelar" CssClass="btnp" CausesValidation="false" OnClick="btnCancelarResena_Click"/></asp:Panel></div></section></asp:Panel></div>
</asp:Content>





